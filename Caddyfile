# Kejizero订阅转换 - 单容器 Caddy 配置
# 一个 Caddy 进程同时处理三个域名（环境变量注入，默认 localhost）
# 前端: 伺服静态文件 | 后端: 反代 subconverter | 短链: 反代短链服务

# ---- 前端域名: 伺服 Vue 静态页面 ----
{$FRONTEND_DOMAIN} {
    root * /app/web
    file_server
    try_files {path} /index.html
    encode gzip

    tls {$ACME_EMAIL}
}

# ---- 后端域名: 反代 subconverter (25500) ----
{$BACKEND_DOMAIN} {
    reverse_proxy 127.0.0.1:25500
    encode gzip

    tls {$ACME_EMAIL}
}

# ---- 短链域名: 反代短链服务 (7999) ----
{$SHORTLINK_DOMAIN} {
    reverse_proxy 127.0.0.1:7999

    tls {$ACME_EMAIL}
}
