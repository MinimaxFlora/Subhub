# ===== Kejizero订阅转换 部署配置 =====
# 使用方法：cp .env.example .env，然后修改下面的三个域名即可
# 然后执行：docker compose up -d --build

# 前端域名（Kejizero订阅转换 页面）
FRONTEND_DOMAIN=sub.kejizero.xyz

# 后端域名（subconverter 订阅转换 API）
BACKEND_DOMAIN=api.kejizero.xyz

# 短链域名（自建短链服务）
SHORTLINK_DOMAIN=short.kejizero.xyz

# TLS 证书邮箱（Let's Encrypt 证书通知，可选）
ACME_EMAIL=admin@kejizero.xyz
