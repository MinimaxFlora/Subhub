# ===== Kejizero订阅转换 部署配置 =====
# 单镜像 zhaoweiwen123/SubHub 包含全部服务：前端 + 后端 + 短链 + Caddy
#
# 本机模式：什么都不用填，直接 docker compose up -d --build
#   前端 http://localhost | 后端 http://localhost:25500 | 短链 http://localhost:7999
#
# 公网模式：填写下面三个域名（需已解析 A 记录到服务器），
# Caddy 会自动反代 + 申请 HTTPS 证书。
# 前端默认调用的后端/短链地址会自动推导为 https://域名（也可手动覆盖）。

# ---- 三个域名（公网模式必填，本机模式留空）----
FRONTEND_DOMAIN=sub.kejizero.xyz
BACKEND_DOMAIN=api.kejizero.xyz
SHORTLINK_DOMAIN=short.kejizero.xyz

# ---- 前端默认调用的后端/短链完整地址（可选，默认自动推导）----
# BACKEND_URL=https://api.kejizero.xyz
# SHORTLINK_URL=https://short.kejizero.xyz

# ---- TLS 证书邮箱（可选）----
ACME_EMAIL=admin@kejizero.xyz
