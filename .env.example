# ===== Kejizero订阅转换 部署配置 =====
# 单镜像 zhaoweiwen123/subhub 包含全部服务：前端 + 后端 + 短链 + Caddy
#
# 两种模式：
#
# 1. 本机模式（下面三个域名留空即可）——端口直连：
#      前端 http://本机IP:8080
#      后端 http://本机IP:25500
#      短链 http://本机IP:7999
#
# 2. 域名模式（填了三个域名，需已解析 A 记录到服务器）——Caddy 反代 + HTTPS：
#      https://FRONTEND_DOMAIN | https://BACKEND_DOMAIN | https://SHORTLINK_DOMAIN
#
# 用法：cp .env.example .env 后按需修改，然后 docker compose up -d --build
#
# ⚠️ 注意：此文件同时是 GitHub Actions 构建镜像时读取域名的来源！
#   前端默认后端/短链地址是编译期写死的，改这里后重新构建镜像才会生效。

# ---- 三个域名（本机模式留空；域名模式填写）----
FRONTEND_DOMAIN=sub.kejizero.xyz
BACKEND_DOMAIN=api.kejizero.xyz
SHORTLINK_DOMAIN=short.kejizero.xyz

# ---- 前端默认调用的后端/短链完整地址（可选，留空自动推导）----
# 本机模式自动推导为 http://localhost:25500 / http://localhost:7999
# 域名模式自动推导为 https://对应域名
BACKEND_URL=https://api.kejizero.xyz
SHORTLINK_URL=https://short.kejizero.xyz

# ---- TLS 证书邮箱（域名模式用）----
ACME_EMAIL=admin@kejizero.xyz
